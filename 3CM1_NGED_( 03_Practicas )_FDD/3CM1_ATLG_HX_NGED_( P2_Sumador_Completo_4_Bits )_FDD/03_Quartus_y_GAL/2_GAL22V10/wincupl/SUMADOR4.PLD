Name       SUMADOR4 ;
PartNo     00 ;
Date       30/09/2026 ;
Revision   01 ;
Designer   Equipo ;
Company    ESCOM-IPN ;
Assembly   None ;
Location   None ;
Device     g22v10 ;

/* ==========================================================================
   Sumador de 4 bits a partir de 4 sumadores completos - GAL22V10 / ATF22V10
   Lenguaje CUPL (WinCUPL). Compilar -> genera SUMADOR4.jed
   Operadores CUPL:  &  AND   #  OR   !  NOT   $  XOR
   ========================================================================== */

/* ---------------- Entradas ---------------- */
Pin 2  = A0 ;
Pin 3  = B0 ;
Pin 4  = A1 ;
Pin 5  = B1 ;
Pin 6  = A2 ;
Pin 7  = B2 ;
Pin 8  = A3 ;
Pin 9  = B3 ;
Pin 10 = Cin ;

/* ---------------- Salidas ----------------- */
Pin 23 = S0 ;
Pin 22 = C0 ;     /* acarreo etapa 0 -> etapa 1 */
Pin 21 = S1 ;
Pin 20 = C1 ;     /* acarreo etapa 1 -> etapa 2 */
Pin 19 = S2 ;
Pin 18 = C2 ;     /* acarreo etapa 2 -> etapa 3 */
Pin 17 = S3 ;
Pin 16 = Cout ;

/* ------- Sumador completo 0 ------- */
S0   = A0 $ B0 $ Cin ;
C0   = (A0 & B0) # (A0 & Cin) # (B0 & Cin) ;

/* ------- Sumador completo 1 ------- */
S1   = A1 $ B1 $ C0 ;
C1   = (A1 & B1) # (A1 & C0) # (B1 & C0) ;

/* ------- Sumador completo 2 ------- */
S2   = A2 $ B2 $ C1 ;
C2   = (A2 & B2) # (A2 & C1) # (B2 & C1) ;

/* ------- Sumador completo 3 ------- */
S3   = A3 $ B3 $ C2 ;
Cout = (A3 & B3) # (A3 & C2) # (B3 & C2) ;
