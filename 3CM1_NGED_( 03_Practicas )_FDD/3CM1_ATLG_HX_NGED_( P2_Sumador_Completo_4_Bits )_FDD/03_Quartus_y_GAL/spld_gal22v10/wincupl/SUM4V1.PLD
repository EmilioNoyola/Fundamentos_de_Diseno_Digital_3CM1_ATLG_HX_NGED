Name     SUM4V1 ;
PartNo   00 ;
Date     04/10/2026 ;
Revision 01 ;
Designer Equipo ;
Company  ESCOM-IPN ;
Assembly None ;
Location None ;
Device   g22v10 ;

/* ===== Sumador completo de 4 bits - VERSION 1 ===== */
/* Operadores CUPL:  &  AND    #  OR    $  XOR    !  NOT  */

/* ---------- Entradas ---------- */
PIN 2  = A0 ;
PIN 3  = B0 ;
PIN 4  = A1 ;
PIN 5  = B1 ;
PIN 6  = A2 ;
PIN 7  = B2 ;
PIN 8  = A3 ;
PIN 9  = B3 ;
PIN 10 = Cin ;

/* ---------- Salidas ---------- */
PIN 23 = S0 ;
PIN 22 = C1 ;
PIN 21 = S1 ;
PIN 20 = C2 ;
PIN 19 = S2 ;
PIN 18 = C3 ;
PIN 17 = S3 ;
PIN 16 = Cout ;

/* ---------- Suma: igual en ambas versiones ---------- */
S0 = A0 $ B0 $ Cin ;
S1 = A1 $ B1 $ C1 ;
S2 = A2 $ B2 $ C2 ;
S3 = A3 $ B3 $ C3 ;

/* VERSION 1 (5 chips): el acarreo reutiliza la XOR  P = A $ B */
C1   = (A0 & B0) # ((A0 $ B0) & Cin);
C2   = (A1 & B1) # ((A1 $ B1) & C1);
C3   = (A2 & B2) # ((A2 $ B2) & C2);
Cout = (A3 & B3) # ((A3 $ B3) & C3);
